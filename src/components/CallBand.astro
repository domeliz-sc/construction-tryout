---
import { load, settingsQuery, type Settings } from '../lib/sanity';
const s = await load<Settings>(settingsQuery, {});
---
<section class="band" aria-labelledby="band-title">
  <div class="wrap band-row">
    <h2 id="band-title" class="display">Planning a build?<br />Let's price it.</h2>
    <div class="band-actions">
      <a class="btn" href="/contact/">Request a quote</a>
      {s.whatsapp && <a class="btn ghost" href={`https://wa.me/${s.whatsapp.replace(/\D/g, '')}`}>WhatsApp us</a>}
    </div>
  </div>
</section>

<style>
  .band { background: var(--mark); padding: clamp(48px, 8vw, 96px) 0; }
  .band-row { display: flex; justify-content: space-between; align-items: end; gap: 32px; flex-wrap: wrap; }
  .band h2 { font-size: clamp(36px, 6vw, 72px); }
  .band-actions { display: flex; gap: 12px; flex-wrap: wrap; }
</style>
