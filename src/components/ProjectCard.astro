---
import { img, formatDate } from '../lib/sanity';
interface Props { p: any; large?: boolean }
const { p, large = false } = Astro.props;
const w = large ? 1400 : 800;
const h = large ? 1000 : 600;
---
<a class:list={['card', { large }]} href={`/projects/${p.slug}/`} data-category={p.category || ''}>
  <div class="card-media">
    {p.cover ? (
      <img
        src={img(p.cover).width(w).height(h).fit('crop').url()}
        srcset={`${img(p.cover).width(w / 2).height(h / 2).fit('crop').url()} ${w / 2}w, ${img(p.cover).width(w).height(h).fit('crop').url()} ${w}w`}
        sizes={large ? '(max-width: 760px) 100vw, 66vw' : '(max-width: 760px) 100vw, 33vw'}
        alt={p.cover.alt || p.title}
        width={w}
        height={h}
        loading="lazy"
      />
    ) : (
      <div class="card-empty"><span class="label">No photo yet</span></div>
    )}
  </div>
  <div class="card-text">
    <h3>{p.title}</h3>
    <p class="muted">{[p.location, p.category, formatDate(p.completed)].filter(Boolean).join(' · ')}</p>
  </div>
</a>

<style>
  .card { text-decoration: none; display: grid; gap: 12px; }
  .card-media { overflow: hidden; background: var(--paper-2); aspect-ratio: 4 / 3; }
  .card.large .card-media { aspect-ratio: 7 / 5; }
  .card-media img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
  .card:hover img { transform: scale(1.03); }
  .card-empty { height: 100%; display: grid; place-items: center; border: 2px dashed var(--line); color: var(--ink-2); }
  .card-text h3 { margin: 0; font-size: 21px; font-variation-settings: 'wdth' 110; font-weight: 750; line-height: 1.15; }
  .card.large .card-text h3 { font-size: 28px; }
  .card-text p { margin: 4px 0 0; font-size: 15px; }
  .card:hover h3 { text-decoration: underline; text-decoration-color: var(--mark); text-decoration-thickness: 3px; text-underline-offset: 5px; }
</style>
