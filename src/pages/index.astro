---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CallBand from '../components/CallBand.astro';
import { load, img, settingsQuery, projectFields, type Settings } from '../lib/sanity';

const s = await load<Settings>(settingsQuery, {});
const projects = await load<any[]>(
  `*[_type == "project" && defined(slug.current)] | order(featured desc, completed desc)[0...5]{ ${projectFields} }`,
  [],
);
const services = await load<any[]>(`*[_type == "service"] | order(order asc){ _id, title, summary }`, []);
const hero = projects.find((p) => p.featured && p.cover) || projects.find((p) => p.cover);
const [lead, ...rest] = projects;
---
<Base>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="label">{s.companyName || 'Construction'}</p>
        <h1 class="display">{s.tagline || 'We build things that last.'}</h1>
        <p class="hero-intro">{s.intro || 'Add your headline and intro in the Studio under Company settings.'}</p>
        <div class="hero-actions">
          <a class="btn mark" href="/contact/">Request a quote</a>
          <a class="btn ghost" href="/projects/">See our work</a>
        </div>
      </div>
      <figure class="hero-media">
        {hero ? (
          <>
            <img
              src={img(hero.cover).width(1100).height(1300).fit('crop').url()}
              alt={hero.cover.alt || hero.title}
              width="1100"
              height="1300"
              fetchpriority="high"
            />
            <figcaption><a href={`/projects/${hero.slug}/`}>{hero.title}{hero.location && `, ${hero.location}`}</a></figcaption>
          </>
        ) : (
          <div class="hero-empty">
            <p class="label">Your best project photo goes here</p>
            <p class="muted">Add a project with a main photo in <a href="/studio">/studio</a>.</p>
          </div>
        )}
      </figure>
    </div>
  </section>

  <section id="services" class="services" aria-labelledby="services-title">
    <div class="wrap">
      <h2 id="services-title" class="display section-title">What we do</h2>
      {services.length ? (
        <ol class="service-list">
          {services.map((sv, i) => (
            <li>
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{sv.title}</h3>
              <p class="muted">{sv.summary}</p>
            </li>
          ))}
        </ol>
      ) : (
        <p class="muted empty">No services yet. Add them in the Studio under Services.</p>
      )}
    </div>
  </section>

  <section class="work" aria-labelledby="work-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="work-title" class="display section-title">Recent work</h2>
        <a class="more" href="/projects/">All projects →</a>
      </div>
      {lead ? (
        <div class="work-grid">
          <div class="work-lead"><ProjectCard p={lead} large /></div>
          <div class="work-rest">{rest.map((p) => <ProjectCard p={p} />)}</div>
        </div>
      ) : (
        <p class="muted empty">No projects yet. Add your first one in the Studio.</p>
      )}
    </div>
  </section>

  <CallBand />
</Base>

<style>
  .hero { padding: clamp(32px, 6vw, 72px) 0 clamp(48px, 8vw, 96px); }
  .hero-grid { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: clamp(24px, 4vw, 56px); align-items: end; }
  .hero h1 { font-size: clamp(44px, 7.4vw, 108px); margin-top: 18px; }
  .hero-intro { font-size: clamp(18px, 1.6vw, 21px); max-width: 38ch; margin: 28px 0 32px; color: var(--ink-2); }
  .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; }
  .hero-media { margin: 0; position: relative; }
  .hero-media img { width: 100%; aspect-ratio: 11 / 13; object-fit: cover; }
  .hero-media figcaption { position: absolute; left: 0; bottom: 0; background: var(--paper); padding: 10px 14px 0 0; font-size: 15px; font-weight: 600; }
  .hero-media figcaption a { text-decoration: none; }
  .hero-empty { aspect-ratio: 11 / 13; border: 2px dashed var(--line); display: grid; place-content: center; text-align: center; padding: 24px; gap: 6px; }
  .hero-empty p { margin: 0; }

  .section-title { font-size: clamp(34px, 5vw, 64px); }
  .section-head { display: flex; justify-content: space-between; align-items: end; gap: 16px; margin-bottom: 32px; }
  .more { font-weight: 700; text-decoration: none; border-bottom: 3px solid var(--mark); }
  .empty { padding: 32px 0; }

  .services { border-top: 2px solid var(--ink); padding: clamp(48px, 7vw, 88px) 0; }
  .service-list { list-style: none; margin: 32px 0 0; padding: 0; }
  .service-list li { display: grid; grid-template-columns: 64px 1fr 1.4fr; gap: 24px; padding: 22px 0; border-top: 1px solid var(--line); align-items: baseline; }
  .service-list li:last-child { border-bottom: 1px solid var(--line); }
  .num { font-variation-settings: 'wdth' 75; font-weight: 700; color: var(--ink-2); }
  .service-list h3 { margin: 0; font-size: 24px; font-variation-settings: 'wdth' 110; font-weight: 750; }
  .service-list p { margin: 0; }

  .work { padding: clamp(48px, 7vw, 88px) 0; background: var(--paper-2); }
  .work-grid { display: grid; grid-template-columns: 2fr 1fr; gap: clamp(20px, 3vw, 36px); }
  .work-rest { display: grid; gap: clamp(20px, 3vw, 36px); align-content: start; }

  @media (max-width: 860px) {
    .hero-grid, .work-grid { grid-template-columns: 1fr; }
    .hero-media img, .hero-empty { aspect-ratio: 4 / 3; }
    .service-list li { grid-template-columns: 40px 1fr; }
    .service-list li p { grid-column: 2; }
  }
</style>
