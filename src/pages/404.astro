---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="wrap nf">
    <p class="label">404</p>
    <h1 class="display">This page isn't built yet.</h1>
    <a class="btn" href="/">Back to the homepage</a>
  </section>
</Base>
<style>
  .nf { padding: clamp(56px, 10vw, 140px) var(--gutter); }
  h1 { font-size: clamp(40px, 7vw, 96px); margin: 12px 0 32px; max-width: 14ch; }
</style>
